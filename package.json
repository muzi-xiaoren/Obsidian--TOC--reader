{
	"name": "obsidian-toc-reader",
	"version": "1.1.2",
	"description": "Typora-style [TOC] rendering for Obsidian, with clickable jump-to-heading in reading view and Live Preview.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"toc",
		"table-of-contents",
		"typora"
	],
	"author": "muzi-xiaoren",
	"license": "Apache-2.0",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^16.11.6",
		"esbuild": "0.20.2",
		"obsidian": "1.13.1",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
